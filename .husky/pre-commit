#!/usr/bin/env sh

# Worktree bootstrap guard: a fresh git worktree (e.g. a handed-off task
# session under isolation:"worktree") has no node_modules, so the hooks below
# fail with a cryptic error. Fail early with the fix instead. Part of the
# concurrent-session isolation rule — see forge CLAUDE base "Concurrent sessions".
#
# This MUST stay ABOVE the _/husky.sh sourcing. That file is generated by
# `husky install` (the npm `prepare` script), so it is missing in exactly the
# unbootstrapped worktree this guard exists to catch. Sourcing first meant the
# shell died on ".husky/_/husky.sh: No such file or directory" and this message
# never printed — i.e. the guard emitted the very error it was written to
# replace, and did so for every fresh worktree.
if [ ! -d node_modules ]; then
  echo "node_modules missing - this worktree isn't bootstrapped."
  echo "A fresh worktree has no deps. Run 'npm ci' before committing."
  exit 1
fi

. "$(dirname -- "$0")/_/husky.sh"

npm run pre-commit
