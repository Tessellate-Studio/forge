#!/usr/bin/env sh

# Source husky's shim only if it is there. `_/husky.sh` is generated by
# `husky install` (the npm `prepare` script), so it is absent in a fresh
# worktree — while this hook's entire job is a regex over "$1", which needs no
# dependencies at all. Sourcing unconditionally made an unbootstrapped worktree
# die on ".husky/_/husky.sh: No such file or directory" instead of validating
# the message. Trade-off when the shim is absent: HUSKY=0 and ~/.huskyrc are
# not honoured for this hook — acceptable, since the check is dependency-free
# and the shim is present in every bootstrapped checkout.
husky_sh="$(dirname -- "$0")/_/husky.sh"
if [ -f "$husky_sh" ]; then
  . "$husky_sh"
fi

# Validate commit message format (conventional commits)
commit_regex='^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: .{1,50}'

if ! grep -qE "$commit_regex" "$1"; then
    echo "Invalid commit message format!"
    echo "Format should be: type(scope): description"
    echo "Examples:"
    echo "  feat: add new validation rule"
    echo "  fix(cli): resolve init command bug"
    echo "  docs: update README"
    exit 1
fi
